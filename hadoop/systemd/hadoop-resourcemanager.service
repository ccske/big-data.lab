[Unit]
Description=Apache Hadoop YARN ResourceManager
After=network-online.target hadoop-namenode.service
Wants=network-online.target hadoop-namenode.service
PartOf=hadoop.target

[Service]
Type=forking
User={{YARN_USER}}
Group={{HADOOP_GROUP}}
ExecStart={{HADOOP_HOME}}/bin/yarn --daemon start resourcemanager
ExecStop={{HADOOP_HOME}}/bin/yarn --daemon stop resourcemanager
PIDFile={{HADOOP_PID_DIR}}/hadoop-{{YARN_USER}}-resourcemanager.pid
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=120
LimitNOFILE=65536
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
