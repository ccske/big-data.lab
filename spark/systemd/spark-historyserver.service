[Unit]
Description=Apache Spark History Server
After=network-online.target hadoop-namenode.service hadoop-datanode.service hadoop-resourcemanager.service
Wants=network-online.target hadoop-namenode.service hadoop-datanode.service hadoop-resourcemanager.service
Requires=hadoop-namenode.service

[Service]
Type=forking
User={{SPARK_USER}}
Group={{HADOOP_GROUP}}
ExecStart={{SPARK_HOME}}/sbin/start-history-server.sh
ExecStop={{SPARK_HOME}}/sbin/stop-history-server.sh
PIDFile={{SPARK_PID_DIR}}/spark-{{SPARK_USER}}-org.apache.spark.deploy.history.HistoryServer-1.pid
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120
TimeoutStopSec=120
LimitNOFILE=65536
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
